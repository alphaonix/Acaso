# Copie para .env se quiser mudar os padroes. O compose funciona sem este arquivo.
POSTGRES_DB=retencao
POSTGRES_USER=etl
POSTGRES_PASSWORD=troque-em-producao
# OPCIONAL. As contas de quem avalia o desafio ja vem no banco (migracao 029, so o hash da senha). Use isto so para trocar a lista
# de contas (formato email|Nome;email|Nome): as contas fora da lista saem do banco.
DASH_USERS=pessoa1@exemplo.com|Pessoa Um|https://exemplo.com/foto1.jpg;pessoa2@exemplo.com|Pessoa Dois   # a URL da foto e opcional
# Senha das contas acima (escolha a sua). Se ficar vazia, cada conta nova recebe uma senha aleatoria.
DASH_PASSWORD=
# Usuario somente leitura usado pela API (le apenas gold e ops)
API_DB_USER=api_ro
API_DB_PASSWORD=troque-em-producao